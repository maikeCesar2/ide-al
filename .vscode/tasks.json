    {
      "label": "Adcos Ideas - Frontend",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoExit"],
      "options": {
        "cwd": "${workspaceFolder}/adcos-ideas/frontend"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
